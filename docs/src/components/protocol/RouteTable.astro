---
import { protocolRouteSlug, type ProtocolVersion } from '../../protocol';
import { anchorOf, checkTablePage, openApiDocument, pageHref, protocolTablePage } from './contract';

interface Props {
	readonly version: ProtocolVersion;
}

const { version } = Astro.props;
const { routes } = await openApiDocument(version);
checkTablePage(
	Astro.locals.starlightRoute.id,
	protocolTablePage(version, 'routes'),
	`protocol/${version}/openapi.yaml's routes`
);
---

<table>
	<thead>
		<tr>
			<th>Route</th>
			<th>Method</th>
			<th>Description</th>
		</tr>
	</thead>
	<tbody>
		{routes.map(({ path, method, operationId, description }) => (
			<tr id={anchorOf('routes', operationId)}>
				<td>
					<a href={pageHref(protocolRouteSlug(version, operationId))}>
						<code>{path}</code>
					</a>
				</td>
				<td>
					<code>{method}</code>
				</td>
				<td>{description}</td>
			</tr>
		))}
	</tbody>
</table>
