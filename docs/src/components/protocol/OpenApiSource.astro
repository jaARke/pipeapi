---
import { Code } from '@astrojs/starlight/components';
import { protocolFileOnGitHub, protocolFilePath, type ProtocolVersion } from '../../protocol';
import { openApiDocument } from './contract';

interface Props {
	readonly version: ProtocolVersion;
}

const { version } = Astro.props;
const { source } = await openApiDocument(version);
---

<p>
	The OpenAPI document as the repository holds it, with every schema in full. It is also on
	<a href={protocolFileOnGitHub(version, 'openapi.yaml')}>GitHub</a>.
</p>
<Code code={source} lang="yaml" title={protocolFilePath(version, 'openapi.yaml')} />
