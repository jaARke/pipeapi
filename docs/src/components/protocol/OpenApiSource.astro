---
import { Code } from '@astrojs/starlight/components';
import { getEntry } from 'astro:content';
import { protocolFileOnGitHub, protocolFilePath, type ProtocolVersion } from '../../protocol';

interface Props {
	readonly version: ProtocolVersion;
}

const { version } = Astro.props;
const path = protocolFilePath(version, 'openapi.yaml');
const openApi = await getEntry(`${version}OpenApiSource`, version);
if (openApi === undefined) {
	throw new Error(`${path} did not load.`);
}
---

<p>
	The OpenAPI document as the repository holds it, with every schema in full. It is also on
	<a href={protocolFileOnGitHub(version, 'openapi.yaml')}>GitHub</a>.
</p>
<Code code={openApi.data.source} lang="yaml" title={path} />
