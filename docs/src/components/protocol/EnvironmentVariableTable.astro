---
import { getCollection } from 'astro:content';
import type { ProtocolVersion } from '../../protocol';
import { sortedById } from './entries';

interface Props {
	readonly version: ProtocolVersion;
}

const { version } = Astro.props;
const variables = sortedById(await getCollection(`${version}EnvironmentVariables`));
---

<table>
	<thead>
		<tr>
			<th>Variable</th>
			<th>Description</th>
		</tr>
	</thead>
	<tbody>
		{variables.map(({ id, data }) => (
			<tr>
				<td>
					<code>{id}</code>
				</td>
				<td>{data.description}</td>
			</tr>
		))}
	</tbody>
</table>
